# JWT configuration
# Use a strong 256-bit Base64 secret in real environments.
JWT_SECRET=replace-with-your-jwt-secret

# PostgreSQL credentials used by Docker Compose
DB_USER=postgres
DB_PASS=postgres

# Mail configuration for notification-service
# For local development, dummy values are acceptable because mail health checks are disabled.
MAIL_USERNAME=dummy@gmail.com
MAIL_PASSWORD=dummy

# Optional service-level overrides
SPRING_KAFKA_BOOTSTRAP_SERVERS=kafka:29092
EUREKA_CLIENT_SERVICE_URL_DEFAULTZONE=http://eureka-server:8761/eureka/